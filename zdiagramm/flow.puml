@startuml
start

:Видео поток с камеры;

:Детекция объектов (YOLO);

:Трекинг объектов (track_id);

:Буферизация кадров по track_id;

if (Достаточно кадров?) then (Да)
  :Создание клипа (16 кадров);
  :Генерация metadata.json;
  :Классификация поведения (ViViT);
  if (Поведение == агрессивное или подозрительное?) then (Да)
    :Отправка тревоги в внешний сервис (REST API);
  else (Нет)
    :Клип сохраняется для анализа;
  endif
else (Нет)
  :Продолжение накопления кадров;
endif

stop
@enduml
